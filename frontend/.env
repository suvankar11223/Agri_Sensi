# AgriSync Frontend Environment Variables

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8000
REACT_APP_PRODUCTION_API_URL=https://agrisync-f1ut.onrender.com

# Blockchain Configuration (Ganache Local Development)
REACT_APP_WEB3_PROVIDER_URL=http://127.0.0.1:7545
REACT_APP_STORAGE_CONTRACT_ADDRESS=0x00c56AE214FaE7C06560b0Eda2bfBb33784fdA48
REACT_APP_MARKETPLACE_CONTRACT_ADDRESS=0x1406E4b10DEb8feA28BF50bd4F66DdABF7d9A5F5

# Environment Detection
NODE_ENV=development

# Optional: External Services (uncomment and configure if needed)
# REACT_APP_INFURA_PROJECT_ID=your_infura_project_id_here
# REACT_APP_INFURA_NETWORK=mainnet

# Optional: Analytics (uncomment and configure if needed)
# REACT_APP_GOOGLE_ANALYTICS_ID=your_ga_id_here

# Optional: Error Reporting (uncomment and configure if needed)
# REACT_APP_SENTRY_DSN=your_sentry_dsn_here
